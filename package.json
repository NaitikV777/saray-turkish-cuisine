{
  "name": "saray-turkish-cuisine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "client": "vite --host 127.0.0.1",
    "server": "node --watch server/index.js",
