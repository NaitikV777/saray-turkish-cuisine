    "postinstall": "npm run build",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.34.5"
  }
}
